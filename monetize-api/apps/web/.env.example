# Copy to .env.local in this directory. Never commit .env.local.

NEXT_PUBLIC_AGNIC_CLIENT_ID=app_...

# Server-only — never expose to the browser
AGNIC_CLIENT_SECRET=secret_...
AGNIC_PARTNER_ID=partner_...

# Optional (web uses {origin}/auth/callback dynamically)
# AGNIC_REDIRECT_URI=http://localhost:3000/auth/callback
# AGNIC_REDIRECT_URI=https://monetizeapi.vercel.app/auth/callback

# Used by pnpm agnic:demo-proof (loaded from this file via core CLI)
AGNIC_BASE_URL=https://api.agnic.ai/v1
AGNIC_ACCESS_TOKEN=
AGNIC_MODEL=gpt-4o-mini
