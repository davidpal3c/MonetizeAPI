# Copy to .env.local in this directory. Never commit .env.local.

AGNIC_CLIENT_ID=app_...

# Server-only — never expose to the browser
AGNIC_CLIENT_SECRET=secret_...
AGNIC_PARTNER_ID=partner_...

# OAuth callback (use on Render/proxy; optional locally if request origin is correct)
# AGNIC_REDIRECT_URI=http://localhost:3000/auth/callback
# AGNIC_REDIRECT_URI=https://monetizeapi.onrender.com/auth/callback
# AGNIC_OAUTH_SCOPES=payments:sign balance:read api:call
# Top-up return_url must match a registered redirect URI on your Agnic OAuth client.

# Used by pnpm agnic:demo-proof (loaded from this file via core CLI)
AGNIC_BASE_URL=https://api.agnic.ai/v1
AGNIC_ACCESS_TOKEN=
# Agnic chat model — must be author/model (e.g. openai/gpt-4o-mini)
AGNIC_MODEL=openai/gpt-4o-mini
