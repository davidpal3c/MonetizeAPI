{
  "name": "monetize-api",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "node scripts/materialize-web-deps.mjs",
    "build": "pnpm -r build",
    "typecheck": "pnpm -r typecheck",
    "generate:fixture": "pnpm --filter @monetize-api/core run generate:fixture",
    "agnic:demo-proof": "pnpm --filter @monetize-api/core run agnic:demo-proof",
    "dev:web": "pnpm --filter @monetize-api/web dev"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@9.15.9"
}
