# Agnic OAuth (apps/web) — copy to .env or apps/web/.env.local
NEXT_PUBLIC_AGNIC_CLIENT_ID=app_...

# Server-only — never expose to the browser
AGNIC_CLIENT_SECRET=secret_...
AGNIC_PARTNER_ID=partner_...

# Optional explicit redirect (must match Agnic registration exactly)
# Dev if you always use localhost:
AGNIC_REDIRECT_URI=http://localhost:3000/auth/callback
# Dev alternate host:
# AGNIC_REDIRECT_URI=http://127.0.0.1:3000/auth/callback
# Production:
# AGNIC_REDIRECT_URI=https://monetizeapi.vercel.app/auth/callback

# Model adapter demo proof (packages/core agnic:demo-proof)
AGNIC_BASE_URL=https://api.agnic.ai/v1
AGNIC_ACCESS_TOKEN=
AGNIC_MODEL=gpt-4o-mini
